# syntax=docker/dockerfile:1.7

# =============================================================================
# Goose migration runner — one-shot container.
# =============================================================================
#
# Pressly publishes the goose Go module but does not maintain an official
# CLI Docker image, and the community-mirrored variants drift in version
# pinning and trust. Building our own from the same golang:1.26-alpine
# base used by the API image keeps us off third-party registries entirely
# and pins to the exact goose version the codebase was tested with.
#
# The container is intentionally a single binary on alpine — no /app, no
# shell session expected - and ships with the schema files baked in at
# /migrations. It runs once per environment-bootstrap, applies the
# migrations from /migrations, and exits with status 0 on success or
# non-zero on failure.
#
# Two consumers gate on this:
#   - docker compose: depends_on -> service_completed_successfully holds
#     the api service back until this one returns 0.
#   - Helm chart (deploy/charts/optivest, v0.2+): runs this image as a
#     pre-install / pre-upgrade hook Job, so `helm upgrade --install`
#     blocks until the Job succeeds before rolling out the API
#     Deployment.
#
# Bumping a schema file means rebuilding this image and shipping a new
# tag. Schema-on-disk and binary-runtime drift is impossible by
# construction: the image IS the schema for the goose version it pairs
# with.
# =============================================================================

# ---------- Stage 1: install goose ----------
FROM golang:1.26-alpine AS builder

# Pin the goose version explicitly. Bumping it is a one-line change and a
# new image tag, so operators can roll forward without surprise. Keep this
# at the latest 3.x release so transitive deps (jwt, pgx, x/crypto, grpc)
# pick up upstream CVE fixes; trivy gates the build on HIGH/CRITICAL so
# stale pins fail loudly rather than silently shipping vulnerable bytes.
ARG GOOSE_VERSION=v3.27.1

RUN apk add --no-cache git \
    && go install github.com/pressly/goose/v3/cmd/goose@${GOOSE_VERSION}

# ---------- Stage 2: minimal runtime ----------
FROM alpine:3.24

# Runtime contains only what `goose` needs to do its job:
#   - ca-certificates: TLS to managed-Postgres providers (RDS, Neon, etc.)
#   - a non-root user: defense-in-depth for the <1s lifetime of this Pod
#
# We deliberately do NOT ship postgresql-client. It used to be bundled
# for ad-hoc `psql` inspection, but it dragged libpq + postgresql18-client
# into the image — surface area that trivy gates against on every push
# (CVE-2026-6638 / postgres 18.3 -> 18.4 was the trigger). For the
# occasional manual psql session, run a sidecar instead, e.g.:
#
#   kubectl run psql --rm -it --image=postgres:18-alpine -- psql "$DSN"
#
# The migrations are read-only-mounted at /migrations and the only
# privilege the migrator needs is "open a TCP connection to postgres",
# which any user has.
RUN apk add --no-cache ca-certificates \
    && addgroup -S goose \
    && adduser -S -u 10001 -G goose goose

COPY --from=builder /go/bin/goose /usr/local/bin/goose

# Bake the schema into the image at /migrations. The default WORKDIR
# below means `goose up` (the default ENTRYPOINT+CMD pair) finds the
# files here without needing an explicit -dir flag. Files are world-
# readable by default (0644), and the migrate Pod runs with a
# read-only root filesystem in Kubernetes, so no chown is needed —
# goose only needs read access.
COPY internal/sql/schema/ /migrations/

WORKDIR /migrations
USER goose

ENTRYPOINT ["goose"]
CMD ["up"]
